# Copy to .env and load it before starting the services (for example: set -a; source .env; set +a).
# There are deliberately NO defaults for these two: a missing value stops the service at startup.

# Shared by auth, product, inventory and order service. Minimum 32 characters.
#   openssl rand -base64 48
JWT_SECRET=

# Password of the first admin account (admin@smartorder.local). Without it no admin is created,
# and nobody can approve seller brands.
ADMIN_PASSWORD=

# Optional overrides (shown with their defaults)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PRODUCT_UPLOAD_DIR=./uploads/products
